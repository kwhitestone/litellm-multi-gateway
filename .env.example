# 复制为 .env 并填入真实值。.env 已在 .gitignore 中，不会进 git。
# multi profile 同时加载 ark/claude/zai 三个后端，按需填对应 key。

# ===== 网关管理密钥（master key，与 provider key 解耦）=====
# 线上：单独生成一个随机长串（如 sk-gw-xxx）；本地：可填 ARK_API_KEY 的值保持原行为
GATEWAY_MASTER_KEY=sk-gw-change-me

# ===== 数据库 =====
# 本地 compose：指向容器内 pg（默认即可）
# 线上（PaaS）：填托管 PG 连接串，如 postgresql://user:pass@host:5432/db
DATABASE_URL=postgresql://litellm:litellm@db:5432/litellm

# ===== provider key（各后端的 API key）=====
ARK_API_KEY=ark-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx   # 火山 ark coding plan token
CLAUDE_CODE_KEY=sk-xxxxxxxx                             # 公司 Claude 网关 key
# 多 key 隔离用量（可选，对应 claude_1/claude_2 后端）
# CLAUDE_CODE_KEY_1=sk-xxxxxxxx
# CLAUDE_CODE_KEY_2=sk-xxxxxxxx
Z_AI_API_KEY=your-zhipu-key                             # 智谱 BigModel key（vision hook 的视觉模型默认也用它）

# ===== Admin UI 登录凭据（务必改强密码）=====
UI_USERNAME=admin
UI_PASSWORD=change-me

# 视觉模型可换（任何 OpenAI 兼容的视觉模型都行；不填则用 Z_AI_API_KEY + 智谱 glm-5v-turbo）
# VISION_API_KEY=
# VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# VISION_MODEL=glm-5v-turbo

# 线上部署用：对外公开地址（管理页展示给客户端的 BASE_URL，留空则用 http://127.0.0.1:PORT）
# PUBLIC_BASE_URL=https://your-gateway.example.com

# Postgres（仅本地 compose 用，线上走 DATABASE_URL）
# POSTGRES_USER=litellm
# POSTGRES_PASSWORD=litellm
# POSTGRES_DB=litellm
