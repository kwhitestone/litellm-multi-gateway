# 复制为 .env 并填入真实值。.env 已在 .gitignore 中，不会进 git。

# ===== 必填 =====
# 上游 coding provider 的 key（默认示例：火山 ark coding plan token）
ARK_API_KEY=ark-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 视觉模型 key（默认示例：智谱 BigModel，用于 glm-4.6v 看图）
# 仅启用 vision 插件时需要
Z_AI_API_KEY=your-zhipu-key

# ===== 可选 =====
# LiteLLM Admin UI 登录凭据
# UI_USERNAME=admin
# UI_PASSWORD=change-me

# 视觉模型可换（任何 OpenAI 兼容的视觉模型都行）
# VISION_API_KEY=        # 不填则复用 Z_AI_API_KEY
# VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# VISION_MODEL=glm-4.6v

# Postgres（默认即可，生产建议改密码）
# POSTGRES_USER=litellm
# POSTGRES_PASSWORD=litellm
# POSTGRES_DB=litellm
